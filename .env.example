# Environment configuration for homomorphic-ckks-floating-engine
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# HMAC-SHA256 audit trail signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
